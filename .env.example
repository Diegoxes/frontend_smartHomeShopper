# API Gateway — único punto de entrada a los microservicios (NO apuntar a puertos 8081-8084).
# Copia a .env: cp .env.example .env
#
# Docker Compose (gateway Node + invcore Java):
VITE_API_BASE_URL=http://localhost:8080
#
# Render / Railway (gateway Node público):
VITE_API_BASE_URL=https://api-gateway-15.onrender.com
